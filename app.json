{
  "expo": {
    "name": "EventEase",
    "slug": "eventease",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.eventease.app",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.eventease.app",
      "blockedPermissions": ["android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EventEase utilise ta position uniquement pour calculer la distance jusqu'au lieu d'un événement."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 112
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "EventEase ajoute à ton calendrier les événements que tu choisis, seulement quand tu le demandes.",
          "remindersPermission": false
        }
      ]
    ],
    "scheme": "eventease",
    "extra": {
      "eas": {
        "projectId": "2a0cbe52-6e14-41c5-9990-c34c114663f8"
      }
    },
    "owner": "jeeiib"
  }
}
